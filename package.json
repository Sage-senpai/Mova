{
  "name": "mova",
  "private": true,
  "description": "Intent-driven payment orchestration between African local rails and Pollar/BOB settlement.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @mova/web dev",
