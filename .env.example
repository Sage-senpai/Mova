# Copy to .env.local (gitignored) and fill in real values.
# Nothing here is required to run the app — every rail falls back to an
# honest simulator without it. See docs/pollar-integration.md.

# Real Pollar testnet secret key (dashboard.pollar.xyz -> Build -> API
# Keys -> sec_testnet_...). SERVER-SIDE ONLY — never expose this to the
# browser or commit it. With this set, @mova/settlement-pollar genuinely
# calls Pollar's live Server API (POST /v1/users/with-wallet, POST
# /v1/wallets/fund) to create and fund a real Stellar testnet wallet as
# part of createTransfer(). It does NOT make quote/send/status real —
# Pollar's own Security Model requires a user-signed client session for
# those; see packages/settlement/pollar/src/pollarClient.ts.
POLLAR_SECRET_KEY=

# Real Pollar testnet publishable key (dashboard.pollar.xyz -> Build ->
# API Keys -> pub_testnet_...). Safe to expose in the browser bundle
# (NEXT_PUBLIC_ prefix is intentional) — reserved for a future client-side
# @pollar/react integration (login + user-signed send). Not yet wired to
# any component in this build.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=
